}
async function generateReport() {
    const btn = event.target; btn.textContent='...'; btn.disabled=true;
    try {
        const promResp = await fetch('/api/prompt_reports');
        const prompts = await promResp.json();
        const active = prompts.filter(p => p.is_active);
        let promptId = null;
        if (active.length === 1) { promptId = active[0].id; }
        else if (active.length > 1) {
            promptId = await new Promise(resolve => {
                let overlay = document.createElement('div');
                overlay.style.cssText = 'position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.5);z-index:9999;display:flex;align-items:center;justify-content:center;';
                let box = document.createElement('div');
                box.style.cssText = 'background:#2a2a2a;border-radius:12px;padding:24px;max-width:420px;width:90%;box-shadow:0 4px 24px rgba(0,0,0,0.4);color:#f5f5f5;';
                box.innerHTML = '<h3 style="color:#00bfff;margin:0 0 12px;">Выберите промпт для отчёта</h3>';
                active.forEach(p => {
                    let b = document.createElement('button');
                    b.style.cssText = 'display:block;width:100%;padding:10px;margin:4px 0;border:1px solid #444;border-radius:8px;background:#333;color:#f5f5f5;cursor:pointer;text-align:left;font-size:13px;';
                    b.textContent = p.name + (p.is_default ? ' ★' : '');
                    b.onclick = () => { overlay.remove(); resolve(p.id); };
                    box.appendChild(b);
                });
                let skip = document.createElement('button');
                skip.style.cssText = 'display:block;width:100%;padding:8px;margin-top:8px;border:1px solid #444;border-radius:8px;background:transparent;color:#aaa;cursor:pointer;font-size:12px;';
                skip.textContent = 'Без промпта (стандартный)';
                skip.onclick = () => { overlay.remove(); resolve(null); };
                box.appendChild(skip);
                overlay.appendChild(box);
                document.body.appendChild(overlay);
            });
        }
        const r = await fetch('/generate_report', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({sql_query: sqlQuery, question: question, include_charts: true, prompt_id: promptId})});
        const d = await r.json();
        if (d.status==='ok') window.open('/download_file/'+d.filename);
        else alert(d.message);
    } catch(e) { alert(e); }
    btn.textContent='Отчёт'; btn.disabled=false;
}
async function sendToRedash() {
    const btn = event.target; btn.textContent='...'; btn.disabled=true;
    try {
        const r = await fetch('/send_to_redash', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({question: question||'Query', sql_query: sqlQuery})});
        const d = await r.json();
        alert(d.status==='ok' ? 'Отправлено в BI' : d.message||'Ошибка');
    } catch(e) { alert(e); }
    btn.textContent='Послать в BI'; btn.disabled=false;
}
function downloadExcel() {
    if (!resultCols.length) return alert('Нет данных');
    var wb = XLSX.utils.book_new();
    wb.SheetNames.push('Data');
    wb.Sheets.Data = XLSX.utils.aoa_to_sheet([resultCols, ...resultRows]);
    XLSX.writeFile(wb, 'query.xlsx');
}
function toggleSqlEdit() {
    const textarea = document.querySelector('.sql-block');
    if (!textarea) return;
    if (textarea.readOnly) {
        textarea.readOnly = false;
        textarea.style.backgroundColor = 'var(--bg-input)';
        textarea.style.border = '1px solid var(--border-input-focus)';
        const btn = document.querySelector('.btn.btn-outline');
        if (btn) btn.textContent = 'Отменить редактирование';
    } else {
        textarea.readOnly = true;
        textarea.style.backgroundColor = 'var(--bg-surface-alt)';
        textarea.style.border = '1px solid var(--border-light)';
        const btn = document.querySelector('.btn.btn-outline');
        if (btn) btn.textContent = 'Редактировать SQL';
    }
}
