.btn-outline { background:transparent; color:var(--text-accent); border:1px solid var(--text-accent); }
.btn-outline:hover { background:var(--text-accent); color:var(--text-on-primary); }
.sql-block { background:var(--bg-surface-alt); border:1px solid var(--border-light); border-radius:6px; padding:12px; margin:12px 0; font-family:monospace; font-size:13px; color:var(--text-code); white-space:pre-wrap; overflow-x:auto; max-height:600px; height:300px; overflow-y:auto; }
.query-box { display:flex; gap:10px; align-items:flex-start; }
