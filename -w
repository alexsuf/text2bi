var loadingOverlay = null;

function getOrCreateLoading() {
    if (loadingOverlay) return loadingOverlay;
    loadingOverlay = document.createElement('div');
    loadingOverlay.className = 'loading-overlay';
    loadingOverlay.innerHTML = '<div class="loading-panel"><div class="typing"><span></span><span></span><span></span></div><div class="loading-text">Идет обработка запроса...</div></div>';
    document.body.appendChild(loadingOverlay);
    return loadingOverlay;
}

function showLoading() { getOrCreateLoading().classList.add('show'); }
function hideLoading() { if (loadingOverlay) loadingOverlay.classList.remove('show'); }

// ── History ────────────────────────────────────────────────────
async function loadHistory() {
    try {
        const r = await fetch('/api/query_history');
        const items = await r.json();
        const list = document.getElementById('historyList');
        if (!list) return;
        list.innerHTML = '';
        if (!items.length) {
            list.innerHTML = '<div style="color:var(--text-muted);font-size:12px;padding:12px;text-align:center;">История пуста</div>';
            return;
        }
        items.forEach(function(h) {
            const div = document.createElement('div');
            div.className = 'history-item';
            const shortQ = h.question.length > 60 ? h.question.substring(0, 60) + '...' : h.question;
            const shortS = (h.sql_query || '').length > 60 ? h.sql_query.substring(0, 60) + '...' : (h.sql_query || '');
            const dateStr = h.created_at ? new Date(h.created_at).toLocaleString('ru-RU') : '';
            div.innerHTML = '<div class="hq" title="' + h.question.replace(/"/g,'&quot;') + '">' + shortQ + '</div>' +
                            '<div class="hs">' + (shortS ? 'SQL: ' + shortS : '') + '</div>' +
                            '<div class="ht">' + dateStr + '</div>';
            div.onclick = function() { loadHistoryItem(h.question, h.sql_query || ''); };
            list.appendChild(div);
        });
    } catch(e) { console.error('History load error:', e); }
}

function loadHistoryItem(q, sql) {
    document.getElementById('questionInput').value = q;
    question = q;
    sqlQuery = sql;
    let block = document.querySelector('.sql-block');
    if (block) {
        block.value = sql;
        block.textContent = sql;
        block.readOnly = true;
    } else {
        block = document.createElement('textarea');
        block.className = 'sql-block';
        block.readOnly = true;
        block.value = sql;
        block.textContent = sql;
        document.getElementById('queryForm').appendChild(block);
        const row = document.createElement('div');
        row.className = 'btn-row';
        row.style.marginTop = '10px';
        row.innerHTML = '<button type="button" class="btn btn-outline" onclick="toggleSqlEdit()">Редактировать SQL</button><button type="button" class="btn btn-primary" onclick="executeSql()">Выполнить SQL</button>';
        document.getElementById('queryForm').appendChild(row);
    }
}

async function saveHistory() {
    const q = document.getElementById('questionInput').value.trim();
    const block = document.querySelector('.sql-block');
    const sql = block ? block.value || block.textContent : sqlQuery;
    if (!sql) return;
    try {
        await fetch('/api/query_history', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({question: q, sql_query: sql})
        });
        loadHistory();
    } catch(e) { console.error('History save error:', e); }
}

async function clearHistory() {
    if (!confirm('Очистить всю историю запросов?')) return;
    try {
        await fetch('/api/query_history', {method: 'DELETE'});
        loadHistory();
    } catch(e) { console.error('History clear error:', e); }
}

// ── AJAX form submission ───────────────────────────────────────
document.getElementById('queryForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    const q = document.getElementById('questionInput').value.trim();
    if (!q) return;
    await generateSql({question: q, sql_query: ''});
});

document.getElementById('questionInput').addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        document.getElementById('queryForm').dispatchEvent(new Event('submit'));
    }
});

async function generateSql(data) {
    showLoading();
    try {
        const resp = await fetch('/api/generate_sql', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify(data)
        });
        const json = await resp.json();
        updatePageFromJson(json);
        if (json.sql_query) saveHistory();
    } catch(e) {
        alert('Ошибка: ' + e.message);
    } finally {
        hideLoading();
    }
}

async function executeSql() {
    const block = document.querySelector('.sql-block');
    if (!block) { alert('Нет SQL для выполнения'); return; }
    const sql = block.value.trim();
    if (!sql) { alert('SQL-запрос пуст'); return; }
    await generateSql({question: '', sql_query: sql});
}

function updatePageFromJson(data) {
    if (data.question) {
        document.getElementById('questionInput').value = data.question;
        question = data.question;
    }
    if (data.sql_query) {
        sqlQuery = data.sql_query;
        updateSqlBlock(data.sql_query);
    }
    if (data.result && data.result.rows) {
        updateResultTable(data.result, data.model_time, data.sql_time);
    } else if (data.result && data.result.error) {
        updateErrorBlock(data.result.error, data.analysis);
    }
}

function updateSqlBlock(sql) {
    let block = document.querySelector('.sql-block');
    if (!block) {
        block = document.createElement('textarea');
        block.className = 'sql-block';
        block.readOnly = true;
        document.getElementById('queryForm').appendChild(block);
        const row = document.createElement('div');
        row.className = 'btn-row';
        row.style.marginTop = '10px';
        row.innerHTML = '<button type="button" class="btn btn-outline" onclick="toggleSqlEdit()">Редактировать SQL</button>' +
                        '<button type="button" class="btn btn-primary" onclick="executeSql()">Выполнить SQL</button>';
        document.getElementById('queryForm').appendChild(row);
    }
    block.value = sql;
    block.textContent = sql;
    block.setAttribute('data-original', sql);
}

function updateResultTable(result, mt, st) {
    resultCols = result.columns || [];
    resultRows = result.rows || [];
    resultCount = resultRows.length;
    modelTime = mt || 0;
    sqlTime = st || 0;

    let card = document.getElementById('resultCard');
    const errCard = document.getElementById('errorCard');
    if (errCard) errCard.remove();

    if (!card) {
        card = document.createElement('div');
        card.className = 'card';
        card.id = 'resultCard';
        document.querySelector('.content-area').appendChild(card);
    }

    const cols = resultCols.map(c => { const s = document.createElement('div'); s.textContent = c; return s[0] ? c : (c || ''); });
    const headers = resultCols.map(c => '<th>' + esc(c) + '</th>').join('');
    const rows = resultRows.map(row => '<tr>' + row.map(v => '<td>' + esc(String(v ?? '')) + '</td>').join('') + '</tr>').join('');

    card.innerHTML =
        '<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">' +
        '<h3 style="color:var(--text-success); margin:0; font-size:15px;">Результат</h3>' +
        '<div class="btn-row">' +
        '<button class="btn btn-blue" onclick="openChat(sqlQuery)">Чат</button>' +
        '<button class="btn btn-blue" onclick="openGraf(sqlQuery)">График</button>' +
        '<button class="btn btn-blue" onclick="openTable(sqlQuery)">Таблица</button>' +
        '<button class="btn btn-blue" onclick="generateReport()">Отчёт</button>' +
        '<button class="btn btn-blue" onclick="sendToRedash()">Послать в BI</button>' +
        '<button class="btn btn-blue" onclick="downloadExcel()">Excel</button>' +
        '</div></div>' +
        '<div class="results"><table><thead><tr>' + headers + '</tr></thead><tbody>' + rows + '</tbody></table></div>' +
        '<div class="info-bar"><span>Строк: ' + resultCount + '</span><span>LLM: ' + modelTime + ' сек</span><span>SQL: ' + sqlTime + ' сек</span></div>';
}

function updateErrorBlock(err, analysis) {
    const resCard = document.getElementById('resultCard');
    if (resCard) resCard.remove();

    let card = document.getElementById('errorCard');
    if (!card) {
        card = document.createElement('div');
        card.className = 'card';
        card.id = 'errorCard';
        document.querySelector('.content-area').appendChild(card);
    }
    let analysisHtml = '';
    if (analysis) analysisHtml = '<div style="margin-top:10px; color:var(--text-primary);">' + analysis + '</div>';
    card.innerHTML = '<div class="analysis-box"><h3>Ошибка</h3><p>' + esc(err) + '</p>' + analysisHtml + '</div>';
}

function esc(s) {
    if (typeof s !== 'string') s = String(s);
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

