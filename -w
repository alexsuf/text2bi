.content-area { flex:1; min-width:0; }
.header-row { display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; }
.header-row h2 { color:var(--text-accent); font-size:20px; }
.card { background:var(--card-bg); border:none; border-radius:10px; padding:16px; margin-bottom:16px; box-shadow:var(--card-shadow); transition:background-color 0.3s ease; }
.card label { color:var(--text-secondary); font-size:12px; display:block; margin-bottom:6px; text-transform:uppercase; font-weight:500; }
.card textarea, .card input { width:100%; background:var(--bg-input); border:1px solid var(--border-input); border-radius:6px; color:var(--text-primary); padding:10px; font-size:14px; font-family:monospace; resize:vertical; }
.card textarea:focus, .card input:focus { border-color:var(--border-input-focus); box-shadow:0 0 0 0.2rem rgba(13,110,253,0.15); outline:none; }
.btn-row { display:flex; gap:8px; flex-wrap:wrap; margin-top:12px; }
.btn { padding:8px 16px; border-radius:6px; border:none; font-size:13px; cursor:pointer; font-weight:500; transition:.15s; display:inline-flex; align-items:center; gap:6px; }
.btn-primary { background:var(--gradient-primary); color:var(--text-on-primary); }
.btn-primary:hover { opacity:0.85; }
.btn-blue { background:var(--gradient-primary); color:var(--text-on-primary); }
.btn-blue:hover { opacity:0.85; }
.btn-red { background:var(--gradient-danger); color:var(--text-on-primary); }
