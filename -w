var resultRows = [["\u041a\u043b\u0438\u0435\u043d\u0442 26", "\u0418\u0432\u0430\u043d\u043e\u0432 \u0418\u0432\u0430\u043d \u0418\u0432\u0430\u043d\u043e\u0432\u0438\u0447", "+7 (812) 937-64-56", "30.1563291139240506", "179560.94", "39278.60", "140282.34"], ["\u041a\u043b\u0438\u0435\u043d\u0442 14", "\u041a\u0443\u0437\u043d\u0435\u0446\u043e\u0432 \u0414\u043c\u0438\u0442\u0440\u0438\u0439 \u0410\u043d\u0434\u0440\u0435\u0435\u0432\u0438\u0447", "+7 (812) 358-50-20", "30.4468478260869565", "177029.68", "40536.68", "136493.00"], ["\u041a\u043b\u0438\u0435\u043d\u0442 40", "\u0412\u0430\u0441\u0438\u043b\u044c\u0435\u0432 \u0410\u043d\u0434\u0440\u0435\u0439 \u041e\u043b\u0435\u0433\u043e\u0432\u0438\u0447", "+7 (812) 856-28-45", "29.2638181818181818", "172041.68", "35690.09", "136351.59"], ["\u041a\u043b\u0438\u0435\u043d\u0442 NEW 46", "\u041b\u0435\u0431\u0435\u0434\u0435\u0432 \u041c\u0438\u0445\u0430\u0438\u043b \u0421\u0435\u0440\u0433\u0435\u0435\u0432\u0438\u0447", "+7 (846) 891-25-24", "43.7760000000000000", "166326.54", "31491.76", "134834.78"], ["\u041a\u043b\u0438\u0435\u043d\u0442 31", "\u041e\u0440\u043b\u043e\u0432 \u041a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u0438\u043d \u0415\u0432\u0433\u0435\u043d\u044c\u0435\u0432\u0438\u0447", "+7 (495) 734-21-64", "26.6335064935064935", "173323.85", "47438.97", "125884.88"]];
var resultCount = resultRows.length;
